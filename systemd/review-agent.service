[Unit]
Description=GitHub Review & Assistant Agent (Antigravity CLI)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# User services run as the invoking user; %h expands to that user's home directory.
WorkingDirectory=%h/github-review-agent
ExecStart=/usr/bin/env bash %h/github-review-agent/review-agent.sh

# `agy` is usually installed to ~/.local/bin, which is not on systemd's default PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# Environment file containing credentials and bot configuration
# Permissions MUST be 0600 (chmod 600 .env)
EnvironmentFile=%h/github-review-agent/.env

# Restart configuration
Restart=always
RestartSec=10

# Security hardening: everything outside the home directory is read-only.
# If the service fails with status 226/NAMESPACE, remove the two lines below.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h

# Standard output and logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
