# ==============================================================================
# GitHub Review & Assistant Agent - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Secure file permissions so only your user can read it:
#      chmod 600 .env
# 3. Fill in your GitHub authentication token and bot configuration below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Personal Access Token (classic or fine-grained) or OAuth token.
# Required scopes / permissions:
#   - 'repo' (Full control of private repositories / code / PRs / issues)
#   - 'notifications' (Access to notifications for polling mentions)
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# ------------------------------------------------------------------------------
# 2. Bot & Admin Identities (REQUIRED)
# ------------------------------------------------------------------------------
# The GitHub username of the bot account running this agent.
# The agent monitors and reacts when @BOT_USER is mentioned in PRs and issues.
BOT_USER="your-bot-username"

# The GitHub username of the primary administrator / repository maintainer.
# The bot always authorizes and executes requests from this user.
ADMIN_USER="your-admin-username"

# ------------------------------------------------------------------------------
# 3. Git Author / Committer Identity (OPTIONAL)
# ------------------------------------------------------------------------------
# Identity used if the agent generates code commits or opens pull requests.
# Defaults to BOT_USER and noreply GitHub email if left blank.
GIT_AUTHOR_NAME="your-bot-username"
GIT_AUTHOR_EMAIL="your-bot-username@users.noreply.github.com"
GIT_COMMITTER_NAME="your-bot-username"
GIT_COMMITTER_EMAIL="your-bot-username@users.noreply.github.com"

# ------------------------------------------------------------------------------
# 4. Monitored Repositories (OPTIONAL)
# ------------------------------------------------------------------------------
# Space-separated or comma-separated list of repositories ("owner/repo")
# to actively poll for recent comment mentions in addition to notification polling.
WATCH_REPOS="owner/repository-name another-owner/another-repo"

# ------------------------------------------------------------------------------
# 5. Agent & Antigravity CLI Execution Options (OPTIONAL)
# ------------------------------------------------------------------------------
# Polling loop interval in seconds (default: 15)
POLL_INTERVAL=15

# Maximum timeout for Antigravity CLI reasoning/execution (default: 15m0s)
AGY_TIMEOUT="15m0s"

# Models to try, in order. The next model is used when one fails (e.g. quota exhausted).
# List valid names with: agy models
# (default: "gemini-3.8-flash-high claude-sonnet-5-5-high gemini-3.1-pro-high")
AGY_MODELS="gemini-3.8-flash-high claude-sonnet-5-5-high gemini-3.1-pro-high"

# Extra CLI flags passed to Antigravity CLI (agy)
AGY_FLAGS="--dangerously-skip-permissions"

# Name shown in the closing "Reviewed by <model> on behalf of <OWNER_NAME>" line of every
# response; it links to https://github.com/ADMIN_USER (default: ADMIN_USER)
OWNER_NAME="Your Name"

# Extra text appended to responses, before the "Reviewed by" line (default: none)
# BOT_FOOTER="\n\n---\n*Automated review powered by Antigravity CLI*"

# ------------------------------------------------------------------------------
# 6. State & Log File Paths (OPTIONAL)
# ------------------------------------------------------------------------------
# Defaults to ./data/processed_comments.txt, ./data/unlocked_threads.txt, ./review.log
# DATA_DIR="./data"
# PROCESSED_FILE="./data/processed_comments.txt"
# UNLOCKED_THREADS_FILE="./data/unlocked_threads.txt"
# LOG_FILE="./review.log"
